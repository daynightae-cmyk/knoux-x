# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock

# Deterministic npm dependency state is committed for Windows/Electron reproducibility.

# Build outputs
dist/
build/
out/
artifacts/
.vite/
*.tsbuildinfo

# Electron
*.log

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Environment
.env
.env.local
.env.*.local

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Native modules
*.node
*.dll
*.so
*.dylib

# Cache
.cache/
.parcel-cache/
.eslintcache

# Chromium/Electron runtime garbage: packaged-run profiles, GPU caches,
# SQLite journals and DevTools ports are regenerated per run and must
# never be committed as evidence.
reports/**/profile/
GPUCache/
DawnGraphiteCache/
*.sqlite3-wal
*.sqlite3-shm
DevToolsActivePort

# Bootstrap exclusions
.webpack/
release/
.env.*
!.env.example
*.pfx
*.pem
*.key

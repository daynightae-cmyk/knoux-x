{
  "name": "knoux-player-x",
  "version": "2.0.0",
  "description": "KNOUX Player X — premium next-generation desktop media player and creative suite.",
  "main": ".vite/build/main-entry.js",
  "author": "Eng. Sadek Elgazar (Knoux)",
  "license": "Proprietary",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "build": "electron-forge package",
    "build:native": "node-gyp rebuild",
    "lint": "eslint --ext .ts,.tsx .",
    "lint:fix": "eslint --ext .ts,.tsx . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:player-viewport": "node tools/test-player-viewport.cjs",
    "typecheck": "tsc --noEmit",
    "analyze": "webpack-bundle-analyzer dist/stats.json",
    "check": "npm run typecheck && npm run lint",
    "doctor": "node tools/doctor.cjs",
    "verify:packaged-ipc": "node tools/run-packaged-ipc-smoke.cjs",
    "verify:sprint-02": "node tools/run-sprint-02-verification.cjs",
    "verify:browser-preview": "node tools/verify-browser-preview.cjs",
    "brand:manifest": "node tools/validate-brand-assets.cjs --write",
    "brand:verify": "node tools/validate-brand-assets.cjs",
    "phase1:verify": "npm run doctor && npm run typecheck && npm run lint && npm run package"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.json" }]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/backups/",
      "<rootDir>/out/",
      "<rootDir>/reports/"
    ]
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.2.0",
    "@electron-forge/plugin-webpack": "^7.2.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.8.1",
    "electron": "32.3.3",
    "electron-devtools-installer": "^3.2.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "node-loader": "^2.0.0",
    "playwright": "^1.40.1",
    "prettier": "^3.1.1",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.3",
    "style-loader": "^3.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3",
    "vite": "^5.4.21",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "@electron-forge/plugin-vite": "^7.2.0",
    "@electron-forge/plugin-fuses": "^7.2.0",
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "dependencies": {
    "@derhuerst/ffprobe-static": "5.3.0",
    "@google/generative-ai": "^0.24.1",
    "@tensorflow/tfjs": "^4.15.0",
    "@tensorflow/tfjs-node": "^4.15.0",
    "better-sqlite3": "11.10.0",
    "electron-log": "^5.0.1",
    "electron-squirrel-startup": "^1.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "events": "^3.3.0",
    "ffmpeg-static": "5.3.0",
    "fluent-ffmpeg": "^2.1.2",
    "framer-motion": "^10.16.16",
    "i18next": "^23.7.11",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-fs-backend": "^2.3.1",
    "lucide-react": "^0.563.0",
    "music-metadata": "^7.14.0",
    "node-id3": "^0.2.6",
    "onnxruntime-node": "^1.16.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.5.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.21.1",
    "sharp": "^0.33.1",
    "xstate": "^5.4.1",
    "zustand": "^4.4.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "media-player",
    "video-player",
    "audio-player",
    "electron",
    "react",
    "typescript",
    "capture",
    "recording",
    "video-editor",
    "creative-suite"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/daynightae-cmyk/knoux-x.git"
  },
  "bugs": {
    "url": "https://github.com/daynightae-cmyk/knoux-x/issues"
  },
  "homepage": "https://knoux.store"
}
